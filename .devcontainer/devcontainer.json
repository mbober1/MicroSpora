{
  "name": "vscode-zephyr",
  "dockerFile": "Dockerfile.devel",
  //  "image": "ghcr.io/mbober1/stm32mp1_zephyros/zephyros-dev-env:master",
  // "image": "zephyrprojectrtos/ci:latest",

  "runArgs": [
  "--privileged"
  ],

  "mounts": [
    "source=/dev/bus/usb/,target=/dev/bus/usb/,type=bind"
  ],

  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/workspace,type=bind",
  "workspaceFolder": "/home/ubuntu/workspace",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux" : "bash",
        "extensions.ignoreRecommendations": true
      },
      "extensions": [
        "ms-vscode.cpptools",
        "marus25.cortex-debug",
        "mcu-debug.debug-tracker-vscode",
        "mhutchie.git-graph"
      ]
    }
  } 
}
