{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-b", "microspora",
				"${workspaceFolder}/app",
				"-DBOARD_ROOT=${workspaceFolder}",
				"-DZEPHYR_BASE=${workspaceFolder}/zephyr",
				"-DDTC_OVERLAY_FILE=${workspaceFolder}/zephyr/samples/subsys/logging/logger/segger_uart_rtt.overlay",
				"-DEXTRA_CONF_FILE=${workspaceFolder}/zephyr/snippets/rtt-console/rtt-console.conf"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Menuconfig",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-t", "menuconfig"
			],
		}
	]
}