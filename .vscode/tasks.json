{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-b", "microspora",
				"${workspaceFolder}/app",
				"-DBOARD_ROOT=${workspaceFolder}",
				"-DZEPHYR_BASE=${workspaceFolder}/zephyr"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Menuconfig",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-t", "menuconfig"
			],
		}
	]
}