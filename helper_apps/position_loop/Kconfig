source "Kconfig.zephyr"

menu "BLDC position controller"

config APP_POSITION_PID_KP_UA_PER_DEG
	int "Position PID proportional gain (uA/degree)"
	default 10000
	range 0 1000000
	help
	  Proportional gain for the position PID. The default is 0.01 A/degree.

config APP_POSITION_PID_KI_UA_PER_DEG
	int "Position PID integral gain (uA/degree per sample)"
	default 1000
	range 0 1000000
	help
	  Integral gain for the position PID. Keep at zero until the controller has
	  been tuned and verified on current-limited hardware.

config APP_POSITION_PID_KD_UA_PER_DEG
	int "Position PID derivative gain (uA/degree per sample difference)"
	default 0
	range 0 1000000
	help
	  Derivative gain for the position PID's discrete error samples.

config APP_POSITION_CURRENT_LIMIT_MA
	int "Position controller current limit (mA)"
	default 250
	range 1 250
	help
	  Maximum magnitude of the q-axis current reference. This application
	  intentionally caps the configured limit at 250 mA.

config APP_POSITION_LOOP_PERIOD_MS
	int "Position controller period (ms)"
	default 10
	range 1 100
	help
	  Fixed period between position PID updates.

endmenu